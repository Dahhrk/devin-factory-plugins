{
  "version": 1,
  "lineLength": 120,
  "indentation": {
    "spaces": 4
  },
  "tabWidth": 4,
  "maximumBlankLines": 1,
  "respectsExistingLineBreaks": true,
  "lineBreakBeforeEachArgument": true,
  "rules": {
    "DoNotUseSemicolons": true,
    "NoBlockComments": true,
    "OrderedImports": true,
    "UseEarlyExits": true
  }
}
