-- Starter GNAT project with gnatpp + gnatcheck-friendly shape (PSR Ada language-farm).
project Product is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-i3", "-M100");
   end Pretty_Printer;

   -- gnatcheck: run `gnatcheck -P product.gpr` in CI (see ada-gates.yml).
   package Check is
      for Default_Switches ("ada") use ("-rules", "-from=gnatcheck.rules");
   end Check;
end Product;
