{
  "$schema": "kit detection registry - seat-kit reads this; add a row when a kit is added",
  "kits": {
    "ada-kit": { "kind": "language", "extensions": [".adb", ".ads"] },
    "apps-script-kit": { "kind": "language", "extensions": [".gs"] },
    "assembly-kit": { "kind": "language", "extensions": [".asm", ".s"] },
    "astro-kit": { "kind": "framework", "extensions": [".astro"], "detect": "astro in package.json" },
    "batchfile-kit": { "kind": "language", "extensions": [".bat", ".cmd"] },
    "c-kit": { "kind": "language", "extensions": [".c", ".h"] },
    "cmake-kit": { "kind": "tooling", "extensions": [".cmake"], "files": ["CMakeLists.txt"] },
    "cobol-kit": { "kind": "language", "extensions": [".cob", ".cbl", ".cpy"] },
    "cpp-kit": { "kind": "language", "extensions": [".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx"] },
    "csharp-kit": { "kind": "language", "extensions": [".cs"] },
    "css-kit": { "kind": "language", "extensions": [".css"] },
    "delphi-kit": { "kind": "language", "extensions": [".pas", ".dpr"] },
    "dockerfile-kit": { "kind": "tooling", "files": ["Dockerfile"], "extensions": [".dockerfile"] },
    "elixir-kit": { "kind": "language", "extensions": [".ex", ".exs"] },
    "fortran-kit": { "kind": "language", "extensions": [".f", ".f90", ".f95", ".f03", ".for"] },
    "go-kit": { "kind": "language", "extensions": [".go"] },
    "gotemplate-kit": { "kind": "tooling", "extensions": [".tmpl", ".gotmpl", ".gohtml"] },
    "html-kit": { "kind": "language", "extensions": [".html", ".htm"] },
    "java-kit": { "kind": "language", "extensions": [".java"] },
    "javascript-kit": { "kind": "language", "extensions": [".js", ".jsx", ".mjs", ".cjs"] },
    "just-kit": { "kind": "tooling", "files": ["justfile", "Justfile"], "extensions": [".just"] },
    "kotlin-kit": { "kind": "language", "extensions": [".kt", ".kts"] },
    "lexyacc-kit": { "kind": "tooling", "extensions": [".l", ".y", ".lex", ".yacc"] },
    "lua-kit": { "kind": "language", "extensions": [".lua"] },
    "makefile-kit": { "kind": "tooling", "files": ["Makefile", "makefile"], "extensions": [".mk"] },
    "mako-kit": { "kind": "tooling", "extensions": [".mako"] },
    "mdx-kit": { "kind": "language", "extensions": [".mdx"] },
    "nix-kit": { "kind": "language", "extensions": [".nix"] },
    "objc-kit": { "kind": "language", "extensions": [".m", ".mm"] },
    "php-kit": { "kind": "language", "extensions": [".php"] },
    "powershell-kit": { "kind": "language", "extensions": [".ps1", ".psm1", ".psd1"] },
    "pug-kit": { "kind": "language", "extensions": [".pug"] },
    "python-kit": { "kind": "language", "extensions": [".py"] },
    "r-kit": { "kind": "language", "extensions": [".r"] },
    "react-kit": { "kind": "framework", "detect": "react in package.json" },
    "ruby-kit": { "kind": "language", "extensions": [".rb"] },
    "rust-kit": { "kind": "language", "extensions": [".rs"] },
    "scss-kit": { "kind": "language", "extensions": [".scss"] },
    "shell-kit": { "kind": "language", "extensions": [".sh", ".bash"] },
    "slint-kit": { "kind": "language", "extensions": [".slint"] },
    "sql-kit": { "kind": "language", "extensions": [".sql"] },
    "swift-kit": { "kind": "language", "extensions": [".swift"] },
    "tailwind-kit": { "kind": "framework", "detect": "tailwind in package.json or tailwind.config.*" },
    "typescript-kit": { "kind": "language", "extensions": [".ts", ".tsx"] },
    "vbnet-kit": { "kind": "language", "extensions": [".vb"] },
    "vite-kit": { "kind": "framework", "detect": "vite.config.*" },
    "wasm-kit": { "kind": "language", "extensions": [".wat", ".wasm"] },
    "zig-kit": { "kind": "language", "extensions": [".zig"] }
  }
}
